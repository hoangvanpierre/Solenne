{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.js",
	"name": "solenne",
	"compatibility_date": "2026-09-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://zxwawiuxcesuoaqczybk.supabase.co",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_7c4tlY1DVbf2BqDv5Dk5xQ_3O4KKBqp"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"ai": {
		// Workers AI — used by the customer chat assistant (app/api/chat/route.ts).
		// No API key is required: the binding is injected by the Workers runtime.
		"binding": "AI"
	},
	"ratelimits": [
		{
			// Per-IP throttle for the Scent Concierge (app/api/chat/route.ts).
			// Cloudflare counts per location; `limit()` is keyed by CF-Connecting-IP.
			"name": "CHAT_RATE_LIMITER",
			// A positive integer, unique to this Cloudflare account.
			"namespace_id": "7301",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			// Per-USER throttle for the admin assistant
			// (app/api/admin-assistant/route.ts — separate from the public
			// storefront concierge, and requires a management session).
			"name": "ADMIN_ASSISTANT_LIMITER",
			// A positive integer, unique to this Cloudflare account.
			"namespace_id": "7302",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "solenne"
		}
	]
}